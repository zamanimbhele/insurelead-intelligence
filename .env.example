# Local development defaults to synthetic JSON data and does not require Supabase.
INSURELEAD_DATA_MODE=demo

NEXT_PUBLIC_APP_NAME="InsureLead Intelligence"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Required when INSURELEAD_DATA_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred key names for new Supabase projects:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy keys are also supported when your project still exposes them:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production MCP writes are disabled unless this is explicitly enabled.
INSURELEAD_MCP_ALLOW_WRITES=false

# Campaign MCP identity. Platform administrators select a broker per campaign;
# broker roles are locked to the configured organisation ID.
INSURELEAD_MCP_ACTOR_ROLE=read_only
INSURELEAD_MCP_ORGANISATION_ID=
INSURELEAD_MCP_ACTOR_LABEL=

# Campaign delivery stays disabled until content has been generated, validated,
# human-approved, and the Resend sender domain is verified. Use test before live.
INSURELEAD_CAMPAIGN_DELIVERY_MODE=disabled
RESEND_API_KEY=
CAMPAIGN_UNSUBSCRIBE_SECRET=
CAMPAIGN_MAX_BATCH_SIZE=25

# Public lead-capture security. RATE_LIMIT_HASH_SECRET is required in Supabase
# mode and must be a random value of at least 32 characters.
RATE_LIMIT_HASH_SECRET=
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=60

# Cloudflare Turnstile. Keep the mode off for local development unless you are
# testing a widget configured to allow localhost.
INSURELEAD_CAPTCHA_MODE=off
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only webhook used to alert the internal lead queue. The payload omits
# contact name, email, and mobile; staff open the authenticated dashboard link.
LEAD_NOTIFICATION_WEBHOOK_URL=
LEAD_NOTIFICATION_WEBHOOK_TOKEN=

# Compliance / legal entity settings
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_FSP_NUMBER=
NEXT_PUBLIC_COMPLIANCE_CONTACT_EMAIL=
