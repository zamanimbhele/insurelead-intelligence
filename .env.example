# ==============================================================================
# InsureLead Intelligence - Environment Variable Template
# Copy to .env.local and populate before running. Never commit real secrets.
# ==============================================================================

NEXT_PUBLIC_APP_NAME="InsureLead Intelligence"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Supabase (required for production - see README "Moving to Production").
# This prototype uses a local JSON demo data store and does NOT require these
# to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Security
FORM_SECURITY_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# Notifications
NOTIFICATION_EMAIL_FROM=""
NOTIFICATION_EMAIL_PROVIDER_API_KEY=""
LEAD_QUEUE_NOTIFICATION_EMAIL=""

# Compliance / legal entity placeholders (configurable by Super Admin in-app)
NEXT_PUBLIC_LEGAL_ENTITY_NAME=""
NEXT_PUBLIC_FSP_NUMBER=""
NEXT_PUBLIC_COMPLIANCE_CONTACT_EMAIL=""
